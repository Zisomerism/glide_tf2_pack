"VertexlitGeneric"
{
	"$basetexture" "models\tf2enhanced\valvo/interior_leather"
	"$bumpmap"	"models\tf2enhanced\normal"

	"$cloakPassEnabled" "1"
	"$nocull" "1"

	"$phong" "1"
	"$phongexponent" "30"
	"$phongboost" "0.1"	
	"$phongfresnelranges"	"[.05 0.1 0.3]"
	"$basemapalphaphongmask" "1"

	// Rim lighting parameters
	"$rimlight" "1"												// To enable rim lighting (requires phong)
	"$rimlightexponent" ""										// Exponent for phong component of rim lighting	
	"$rimlightboost" ".1"										// Boost for ambient cube component of rim lighting

}
