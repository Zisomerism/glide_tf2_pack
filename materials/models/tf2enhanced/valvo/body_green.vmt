"VertexlitGeneric"
{
	"$basetexture" "models\tf2enhanced\valvo/body_green"
	"$bumpmap"	"models\tf2enhanced\normal"

	"$cloakPassEnabled" "1"
	"$nocull" "1"

	$envmap "env_cubemap"
	$envmaptint "[0.1 0.1 0.1]"
	

"$phong" "1"
	"$phongexponent" "4"
	"$phongboost" ".1"	
	//"$lightwarptexture" "models\tf2enhanced/pickup_lightwarp"
	"$phongfresnelranges"	"[1 1 4]"
	"$basemapalphaphongmask" "1"

	// Rim lighting parameters
	"$rimlight" "1"												// To enable rim lighting (requires phong)
	"$rimlightexponent" "2"										// Exponent for phong component of rim lighting	
	"$rimlightboost" ".1"	
}
